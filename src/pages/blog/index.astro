---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog — Chloe Lloyd Studio" description="Notes on wedding stationery, hand-painted illustration, and life in the studio.">
  <section class="blog-hero">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Notes from <em>the studio</em></h1>
      <p class="blog-intro">Wedding stationery ideas, behind-the-scenes of commissions, and the things that inspire the work.</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="wrap">
      {posts.length === 0 && <p class="blog-empty">New posts are on their way.</p>}
      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`${home}blog/${post.id}/`}>
            <div class="post-card-img">
              {post.data.cover && (
                <Image src={post.data.cover} alt={post.data.coverAlt} widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" loading="lazy" />
              )}
            </div>
            <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

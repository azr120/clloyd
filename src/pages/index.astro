---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { TYPEFORM_ID } from '../config';
import amalfi from '../assets/images/amalfi-invitation.jpeg';
import athens from '../assets/images/athens-suite.jpeg';
import essex from '../assets/images/essex-suite.jpeg';
import greek from '../assets/images/greek-invitation.jpeg';
import cocktail from '../assets/images/cocktail-sign.jpeg';
import beach from '../assets/images/beach-seating-plan.jpeg';
import seating from '../assets/images/seating-plan.jpeg';
import mallorca from '../assets/images/mallorca-suite.jpeg';
import oyster from '../assets/images/oyster-menu.jpeg';
import pomegranate from '../assets/images/pomegranate-menu.jpeg';
import coastal from '../assets/images/coastal-wedding.jpeg';
import semaCallum from '../assets/images/sema-callum-invitation.png';
import portrait from '../assets/images/chloe-portrait.png';

// Drop a file named baptism.jpg/.jpeg/.png/.webp into src/assets/images/ and it appears automatically.
const baptismFiles = import.meta.glob<ImageMetadata>('../assets/images/baptism*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const baptism = Object.values(baptismFiles)[0];
---

<Base title="Chloe Lloyd Studio — Wedding Stationery & Illustration" description="Hand-painted wedding stationery and illustration, made to feel like you. Custom invitation suites from a studio in Greece.">
<section class="hero" id="top">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="reveal">Chloe Lloyd <em>Studio</em></h1>
      <p class="tagline reveal d2">Wedding stationery &amp; illustration</p>
      <p class="intro reveal d2">Hand-painted stationery and illustration for weddings and meaningful gatherings, made to feel like you — and nobody else.</p>
      <div class="hero-actions reveal d3">
        <a class="btn" href="#contact">Begin an inquiry</a>
      </div>
    </div>
    <div class="hero-visual reveal d2">
      <Image src={mallorca} alt="Mallorca save the date, invitation and menu with a wax seal" widths={[600, 843]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" />
    </div>
  </div>
</section>

<!-- WEDDING STATIONERY -->
<section class="section stationery on-dark" id="stationery">
  <div class="wrap grid">
    <div>
      <p class="eyebrow">Wedding stationery</p>
      <h2>Because <em>your</em> wedding stationery should feel like you — not like everyone else's.</h2>
      <p class="body">Every commission begins with a brush, a blank page, and the things that make your story yours — a favourite flower, a special place, a memory. I turn those details into original artwork, then carry them across your entire suite.</p>
      <p class="price-note">Prices starting from €200.</p>
    </div>
    <div class="invite-stage">
      <Image src={semaCallum} alt="Hand-painted Sema & Callum wedding invitation with orange slices and blue florals beside an envelope with a wax seal" widths={[600, 1000, 1400]} sizes="(max-width: 860px) 100vw, 56vw" />
    </div>
  </div>
</section>

<!-- COMMISSIONS -->
<section class="section commissions" id="commissions">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Commissions</p>
        <h2>Art for Life’s <em>Other Milestones</em></h2>
      </div>
      <p class="lede">From baptism suites and dinner party menus to custom venue portraits — hand-painted pieces created for the moments and places you never want to forget. <strong>Prices starting from €120.</strong></p>
    </div>
    <div class="comm-grid">
      <div class="comm-card">
        <div class="arch">
          {baptism ? (
            <Image src={baptism} alt="Hand-painted baptism stationery" widths={[480, 736]} sizes="(max-width: 860px) 380px, 33vw" />
          ) : (
            <div class="arch-placeholder">Baptism image coming soon</div>
          )}
        </div>
        <p class="comm-label">Baptisms &amp; Milestones <small>01</small></p>
      </div>
      <div class="comm-card">
        <div class="arch">
          <Image src={oyster} alt="Hand-painted seafood menu card on a plate with a terracotta napkin" widths={[480, 736]} sizes="(max-width: 860px) 380px, 33vw" />
        </div>
        <p class="comm-label">Celebrations &amp; Dinners <small>02</small></p>
      </div>
      <div class="comm-card">
        <div class="arch">
          <Image src={seating} alt="Hand-painted seating plan with floral border on an easel" widths={[480, 736]} sizes="(max-width: 860px) 380px, 33vw" />
        </div>
        <p class="comm-label">Event Signage <small>03</small></p>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="section how on-dark" id="process">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Original artwork, <em>ready to print.</em></h2>
    <p class="sub">From first sketch to print-ready files, your suite takes around 4–6 weeks.</p>
    <div class="steps">
      <div class="step"><span class="num">01</span><span class="step-title">Inquire</span><p>Share your date, your colours and anything that feels like you via my contact form. I’ll follow up with a tailored quote and a link to book a quick chat to talk through your ideas.</p></div>
      <div class="step"><span class="num">02</span><span class="step-title">Concept &amp; palette</span><p>I paint a small set of studies in your palette, so we can agree on the mood before a single word is set.</p></div>
      <div class="step"><span class="num">03</span><span class="step-title">Hand-painted proof</span><p>Your suite is painted in full, photographed, and sent over as a digital proof for your first look.</p></div>
      <div class="step"><span class="num">04</span><span class="step-title">Revisions</span><p>Two rounds are included — from wording and colour to composition — until everything feels just right.</p></div>
      <div class="step"><span class="num">05</span><span class="step-title">Delivery</span><p>Your final print-ready files are sent along with a detailed printing guide, ready for your chosen printer.</p></div>
    </div>
  </div>
</section>

<!-- FAQS -->
<section class="section faqs" id="faqs">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">FAQs</p>
        <h2>Good <em>to know</em></h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>What is the design timeline?</summary>
          <p>The design and proofing process takes 4 to 6 weeks from initial concept to final file delivery. To allow your chosen printer enough time for production, assembly, and mailing, it is best to get in touch 3 to 4 months before your target mail-out date. Although, to ensure I am available to work on your stationery it is best to get in touch as soon as possible.</p>
        </details>
        <details>
          <summary>How does printing work?</summary>
          <p>You or your wedding planner handle physical production with the printer of your choice. Upon design approval, you will receive high-resolution, print-ready digital files, accompanied by a printing guide with my recommendations.</p>
        </details>
        <details>
          <summary>Do you work with international clients?</summary>
          <p>Yes, I design for couples and event planners worldwide. Because all final deliverables are provided digitally as print-ready files, there are no international shipping fees, physical transit delays, or customs holds on your design deliverables.</p>
        </details>
        <details>
          <summary>Can we include custom artwork like crests or venue sketches?</summary>
          <p>Every suite is created completely from scratch. You can include custom venue illustrations, monograms, family crests, or bespoke patterns tailored specifically to your event.</p>
        </details>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="section about" id="about">
  <div class="wrap grid">
    <div class="portrait">
      <Image src={portrait} alt="Portrait of Chloe Lloyd" widths={[420, 840]} sizes="(max-width: 860px) 320px, 420px" />
    </div>
    <div>
      <p class="eyebrow">About</p>
      <blockquote>"The best stationery doesn't just tell your guests where to be. It tells them something about you."</blockquote>
      <div class="bio">
        <p>I'm Chloe, an illustrator and designer creating custom invitation suites for celebrations worldwide. I blend hand-painted illustration with a modern, editorial eye to make pieces that feel original, rich, and deeply personal.</p>
        <p>Working from my studio in Greece, my aesthetic is shaped by Mediterranean light, the seasons, and classical forms — bringing an effortless sense of luxury to every project.</p>
        <p>Ready to create something memorable together?</p>
      </div>
    </div>
  </div>
</section>

<!-- SELECTED WORKS -->
<section class="section works" id="works">
  <div class="wrap">
    <p class="eyebrow">Selected works</p>
    <h2>A few favourite <em>suites</em></h2>
    <div class="works-grid">
      <div class="work-tile wide"><Image src={coastal} alt="Coastal wedding stationery: welcome card, cocktail menu, seating plan, venue illustration and sailboat place card" widths={[736, 1024]} sizes="(max-width: 560px) 100vw, (max-width: 760px) 100vw, 66vw" /></div>
      <div class="work-tile"><Image src={athens} alt="Blue hand-drawn Athens wedding suite with Acropolis and Greek gods" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={amalfi} alt="Hand-painted Amalfi Coast invitation with lemons and Positano" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={greek} alt="Hand-painted Greek wedding invitation with columns on a green and lilac check" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={pomegranate} alt="Pink menu card bordered with hand-painted pomegranates and pears" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={beach} alt="Hand-painted beach wedding seating plan with starfish and waves" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={essex} alt="Hand-painted wedding suite with save the date, invitation and menu in pink and sage" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
      <div class="work-tile"><Image src={cocktail} alt="Hand-painted signature cocktails sign by the sea" widths={[480, 736]} sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px" /></div>
    </div>
  </div>
</section>

<!-- GET IN TOUCH -->
<section class="section contact on-dark" id="contact">
  <div class="wrap">
    <p class="eyebrow">Begin an inquiry</p>
    <h2>Get in <em>touch</em></h2>
    <div class="contact-grid">
      <p class="contact-note"><strong>Let's make something yours.</strong>Tell me a little about your wedding, and I'll reply within a few days with availability and next steps.</p>
      <div>
      <div class="typeform-wrap">
        {TYPEFORM_ID ? (
          <iframe
            src={`https://form.typeform.com/to/${TYPEFORM_ID}?typeform-embed=embed-widget`}
            title="Wedding stationery inquiry form"
            loading="lazy"
            allow="camera; microphone; autoplay; encrypted-media;"
          ></iframe>
        ) : (
          <p class="typeform-missing">The inquiry form isn't connected yet. Set <code>TYPEFORM_ID</code> in <code>src/config.ts</code>.</p>
        )}
      </div>
      {TYPEFORM_ID && (
        <p class="typeform-link">Form not loading? <a href={`https://form.typeform.com/to/${TYPEFORM_ID}`} target="_blank" rel="noopener">Open it in a new tab</a>.</p>
      )}
      </div>
    </div>
  </div>
</section>

</Base>
